import { createContext, useContext, useEffect, useMemo, useState, type ReactNode } from 'react';
import type { Product } from './products';

export interface CartLine {
  productId: string;
  name: string;
  price: number;
  image: string;
  size: string;
  colour: string;
  qty: number;
}

interface ShopState {
  cart: CartLine[];
  wishlist: string[];
  recentlyViewed: string[];
  addToCart: (p: Product, size: string, colour: string, qty?: number) => void;
  removeFromCart: (index: number) => void;
  updateQty: (index: number, qty: number) => void;
  clearCart: () => void;
  toggleWishlist: (id: string) => void;
  isInWishlist: (id: string) => boolean;
  trackView: (id: string) => void;
  cartCount: number;
  cartTotal: number;
}

const ShopContext = createContext<ShopState | null>(null);

const read = <T,>(key: string, fallback: T): T => {
  try {
    const raw = localStorage.getItem(key);
    return raw ? (JSON.parse(raw) as T) : fallback;
  } catch {
    return fallback;
  }
};

export function ShopProvider({ children }: { children: ReactNode }) {
  const [cart, setCart] = useState<CartLine[]>(() => read('me_cart', []));
  const [wishlist, setWishlist] = useState<string[]>(() => read('me_wishlist', []));
  const [recentlyViewed, setRecentlyViewed] = useState<string[]>(() =>
    read('me_recent', [] as string[])
  );

  useEffect(() => {
    localStorage.setItem('me_cart', JSON.stringify(cart));
  }, [cart]);
  useEffect(() => {
    localStorage.setItem('me_wishlist', JSON.stringify(wishlist));
  }, [wishlist]);
  useEffect(() => {
    localStorage.setItem('me_recent', JSON.stringify(recentlyViewed));
  }, [recentlyViewed]);

  const addToCart: ShopState['addToCart'] = (p, size, colour, qty = 1) => {
    setCart((prev) => {
      const idx = prev.findIndex(
        (l) => l.productId === p.id && l.size === size && l.colour === colour
      );
      if (idx >= 0) {
        const next = [...prev];
        next[idx] = { ...next[idx], qty: next[idx].qty + qty };
        return next;
      }
      return [
        ...prev,
        { productId: p.id, name: p.name, price: p.price, image: p.image, size, colour, qty },
      ];
    });
  };

  const removeFromCart = (index: number) =>
    setCart((prev) => prev.filter((_, i) => i !== index));

  const updateQty = (index: number, qty: number) =>
    setCart((prev) =>
      prev.map((l, i) => (i === index ? { ...l, qty: Math.max(1, qty) } : l))
    );

  const clearCart = () => setCart([]);

  const toggleWishlist = (id: string) =>
    setWishlist((prev) =>
      prev.includes(id) ? prev.filter((w) => w !== id) : [...prev, id]
    );

  const isInWishlist = (id: string) => wishlist.includes(id);

  const trackView = (id: string) =>
    setRecentlyViewed((prev) => [id, ...prev.filter((v) => v !== id)].slice(0, 8));

  const cartCount = useMemo(() => cart.reduce((s, l) => s + l.qty, 0), [cart]);
  const cartTotal = useMemo(() => cart.reduce((s, l) => s + l.price * l.qty, 0), [cart]);

  const value: ShopState = {
    cart, wishlist, recentlyViewed, addToCart, removeFromCart, updateQty,
    clearCart, toggleWishlist, isInWishlist, trackView, cartCount, cartTotal,
  };

  return <ShopContext.Provider value={value}>{children}</ShopContext.Provider>;
}

export function useShop() {
  const ctx = useContext(ShopContext);
  if (!ctx) throw new Error('useShop must be used within ShopProvider');
  return ctx;
}
